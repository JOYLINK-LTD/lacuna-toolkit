{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JOYLINK-LTD/lacuna-mcp",
  "title": "Lacuna Music",
  "description": "Generate AI music via the Lacuna Music API from MCP clients like Claude Desktop & Code.",
  "websiteUrl": "https://www.lacuna.fm",
  "repository": {
    "url": "https://github.com/JOYLINK-LTD/lacuna-toolkit",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "version": "0.3.4",
  "icons": [
    {
      "src": "https://www.lacuna.fm/favicon-256x256.png",
      "mimeType": "image/png",
      "sizes": ["256x256"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lacuna-mcp",
      "version": "0.3.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LACUNA_API_KEY",
          "description": "Lacuna API key from https://www.lacuna.fm/profile/api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "LACUNA_BASE_URL",
          "description": "Override the API base URL (optional).",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.lacuna.fm/mcp"
    }
  ]
}
